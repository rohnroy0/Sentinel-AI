# ==============================================================================
# SENTINEL-AI PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Vercel / Netlify / Client)
# ------------------------------------------------------------------------------
# Public backend API endpoint URL
VITE_API_URL=https://your-backend.onrender.com

# Supabase Client Authentication & Database Credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Render / Fly.io / Docker / FastAPI)
# ------------------------------------------------------------------------------
# Database Adapter Selection (supabase | sqlite)
DATABASE_ENGINE=supabase

# Authentication Mode (supabase | demo)
AUTH_MODE=supabase

# Supabase Service Role Credentials (Server-Side Only - Secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
JWT_SECRET=your-supabase-jwt-secret-here

# Production CORS Allowed Origins (Comma-separated allowed domains)
CORS_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# Optional LLM & Intelligence API Keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
NVD_API_KEY=your-nvd-api-key-here

# Local Offline Fallback Storage Path
DATABASE_PATH=./data/investigations.db
