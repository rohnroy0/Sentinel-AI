# Production Database Engine (default: supabase | fallback: sqlite)
DATABASE_ENGINE=supabase

# Production Authentication Mode (default: supabase | fallback: demo)
AUTH_MODE=supabase

# Supabase Production Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional LLM & Intelligence APIs
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
NVD_API_KEY=your-nvd-api-key-here

# Local Offline Fallback Database Path
DATABASE_PATH=./data/investigations.db
